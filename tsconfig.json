{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "module": "ESNext",
    "strict": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.json",
    "global.d.ts"
  ],
  "exclude": [
    "src/services/api.example.ts",
    "src/services/api.example.ts",
  "src/deeplinks/**",
  "src/screens/HomeScreen.tsx"
  ]
}
